-					      sizeof(rctx->sa_record), DMA_TO_DEVICE);
-	ret = dma_mapping_error(ctx->eip93->dev, rctx->sa_record_base);
-	if (ret)
-		return ret;
-
 	rctx->assoclen = 0;
 	rctx->textsize = req->cryptlen;
 	rctx->authsize = 0;
@@ -174,6 +174,7 @@ static int eip93_skcipher_crypt(struct skcipher_request *req, bool encrypt)
 	rctx->ivsize = crypto_skcipher_ivsize(skcipher);
 	rctx->blksize = ctx->blksize;
 	rctx->desc_flags = EIP93_DESC_SKCIPHER;
