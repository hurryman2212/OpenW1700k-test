 7 files changed, 321 insertions(+), 325 deletions(-)

diff --git a/drivers/crypto/inside-secure/eip93/eip93-aead.c b/drivers/crypto/inside-secure/eip93/eip93-aead.c
index 3646be7..100505b 100644
--- a/drivers/crypto/inside-secure/eip93/eip93-aead.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-aead.c
@@ -48,14 +48,21 @@ static int eip93_aead_send_req(struct crypto_async_request *async)
 	int err;
 
 	err = check_valid_request(rctx);
-	if (err) {
-		dma_unmap_single(ctx->eip93->dev, rctx->sa_record_base,
-				 sizeof(rctx->sa_record), DMA_TO_DEVICE);
-		aead_request_complete(req, err);
+	if (err)
 		return err;
+
+	rctx->sa_record_base = dma_map_single(ctx->eip93->dev, &rctx->sa_record,
+					      sizeof(rctx->sa_record), DMA_TO_DEVICE);
+	if (dma_mapping_error(ctx->eip93->dev, rctx->sa_record_base)) {
+		eip93_free_sg_copies(rctx, req->src, req->dst);
+		return -ENOMEM;
 	}
 
-	return eip93_send_req(async, req->iv, rctx);
+	err = eip93_send_req(async, req->iv, rctx);
+	if (err != -EINPROGRESS)
+		eip93_free_sg_copies(rctx, req->src, req->dst);
+
+	return err;
 }
 
 /* Crypto aead API functions */
@@ -71,7 +78,6 @@ static int eip93_aead_cra_init(struct crypto_tfm *tfm)
 	ctx->eip93 = tmpl->eip93;
 	ctx->flags = tmpl->flags;
 	ctx->type = tmpl->type;
-	ctx->set_assoc = true;
 
 	ctx->sa_record = kzalloc(sizeof(*ctx->sa_record), GFP_KERNEL);
 	if (!ctx->sa_record)
@@ -153,8 +159,6 @@ static int eip93_aead_setkey(struct crypto_aead *ctfm, const u8 *key,
 				ctx->authsize, sa_record->sa_i_digest,
 				sa_record->sa_o_digest, false);
 
-	ctx->set_assoc = true;
-
 	return ret;
 }
 
@@ -164,6 +168,9 @@ static int eip93_aead_setauthsize(struct crypto_aead *ctfm,
 	struct crypto_tfm *tfm = crypto_aead_tfm(ctfm);
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(tfm);
 
+	if (!authsize || !IS_ALIGNED(authsize, sizeof(u32)))
+		return -EINVAL;
+
 	ctx->authsize = authsize;
 	ctx->sa_record->sa_cmd0_word &= ~EIP93_SA_CMD_DIGEST_LENGTH;
 	ctx->sa_record->sa_cmd0_word |= FIELD_PREP(EIP93_SA_CMD_DIGEST_LENGTH,
@@ -172,27 +179,24 @@ static int eip93_aead_setauthsize(struct crypto_aead *ctfm,
 	return 0;
 }
 
-static void eip93_aead_setassoc(struct eip93_crypto_ctx *ctx,
-				struct aead_request *req)
-{
-	struct sa_record *sa_record = ctx->sa_record;
-
-	sa_record->sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
-	sa_record->sa_cmd1_word |= FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
-					      req->assoclen / sizeof(u32));
-
-	ctx->assoclen = req->assoclen;
-}
-
 static int eip93_aead_crypt(struct aead_request *req)
 {
 	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
 	struct crypto_async_request *async = &req->base;
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
 	struct crypto_aead *aead = crypto_aead_reqtfm(req);
-	int ret;
+
+	if (!IS_ALIGNED(req->assoclen, sizeof(u32)) ||
+	    req->assoclen / sizeof(u32) >
+			FIELD_MAX(EIP93_SA_CMD_HASH_CRYPT_OFFSET))
+		return -EINVAL;
+	if (IS_DECRYPT(rctx->flags) && req->cryptlen < ctx->authsize)
+		return -EINVAL;
 
 	memcpy(&rctx->sa_record, ctx->sa_record, sizeof(rctx->sa_record));
+	rctx->sa_record.sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
+	rctx->sa_record.sa_cmd1_word |= FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
+						   req->assoclen / sizeof(u32));
 	if (IS_DECRYPT(rctx->flags)) {
 		rctx->sa_record.sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
 		rctx->sa_record.sa_cmd1_word &= ~(EIP93_SA_CMD_COPY_PAD |
@@ -203,12 +207,6 @@ static int eip93_aead_crypt(struct aead_request *req)
 						 EIP93_SA_CMD_COPY_DIGEST;
 	}
 
-	rctx->sa_record_base = dma_map_single(ctx->eip93->dev, &rctx->sa_record,
-					      sizeof(rctx->sa_record), DMA_TO_DEVICE);
-	ret = dma_mapping_error(ctx->eip93->dev, rctx->sa_record_base);
-	if (ret)
-		return ret;
-
 	rctx->textsize = req->cryptlen;
 	rctx->blksize = ctx->blksize;
 	rctx->assoclen = req->assoclen;
@@ -217,6 +215,7 @@ static int eip93_aead_crypt(struct aead_request *req)
 	rctx->sg_dst = req->dst;
 	rctx->ivsize = crypto_aead_ivsize(aead);
 	rctx->desc_flags = EIP93_DESC_AEAD;
+	rctx->err = 0;
 
 	if (IS_DECRYPT(rctx->flags))
 		rctx->textsize -= rctx->authsize;
@@ -231,15 +230,6 @@ static int eip93_aead_encrypt(struct aead_request *req)
 
 	rctx->flags = ctx->flags;
 	rctx->flags |= EIP93_ENCRYPT;
-	if (ctx->set_assoc) {
-		eip93_aead_setassoc(ctx, req);
-		ctx->set_assoc = false;
-	}
-
-	if (req->assoclen != ctx->assoclen) {
-		dev_err(ctx->eip93->dev, "Request AAD length error\n");
-		return -EINVAL;
-	}
 
 	return eip93_aead_crypt(req);
 }
@@ -251,15 +241,6 @@ static int eip93_aead_decrypt(struct aead_request *req)
 
 	rctx->flags = ctx->flags;
 	rctx->flags |= EIP93_DECRYPT;
-	if (ctx->set_assoc) {
-		eip93_aead_setassoc(ctx, req);
-		ctx->set_assoc = false;
-	}
-
-	if (req->assoclen != ctx->assoclen) {
-		dev_err(ctx->eip93->dev, "Request AAD length error\n");
-		return -EINVAL;
-	}
 
 	return eip93_aead_crypt(req);
 }
