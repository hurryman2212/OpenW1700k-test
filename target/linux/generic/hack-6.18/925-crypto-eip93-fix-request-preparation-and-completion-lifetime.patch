-			 sizeof(*sa_state), DMA_FROM_DEVICE);
+			 sizeof(*sa_state), DMA_BIDIRECTIONAL);
 
 	/*
 	 * With partial_hash assume SHA256_DIGEST_SIZE buffer is passed.
@@ -208,26 +211,71 @@ static void __eip93_hash_init(struct ahash_request *req)
 	INIT_LIST_HEAD(&rctx->blocks);
 }
 
-static int eip93_send_hash_req(struct crypto_async_request *async, u8 *data,
-			       dma_addr_t *data_dma, bool *data_mapped,
-			       u32 len, bool last)
+static int eip93_hash_map_data(struct eip93_device *eip93, void *data,
+			       u32 len, dma_addr_t *data_dma,
+			       bool *data_mapped)
+{
+	*data_dma = dma_map_single(eip93->dev, data, len, DMA_TO_DEVICE);
+	if (dma_mapping_error(eip93->dev, *data_dma))
+		return -ENOMEM;
+
+	*data_mapped = true;
+	return 0;
+}
+
+static int eip93_hash_prepare_request(struct crypto_async_request *async,
+				      bool final)
 {
 	struct ahash_request *req = ahash_request_cast(async);
 	struct eip93_hash_reqctx *rctx = ahash_request_ctx_dma(req);
 	struct crypto_ahash *ahash = crypto_ahash_reqtfm(req);
 	struct eip93_hash_ctx *ctx = crypto_ahash_ctx(ahash);
 	struct eip93_device *eip93 = ctx->eip93;
-	struct eip93_descriptor cdesc = { };
-	dma_addr_t src_addr;
+	struct mkt_hash_block *block;
 	int ret;
 
