+	notifier_ctx = bond->notifier_ctx;
+	bond->notifier_ctx = true;
+	netdev_lock_ops(real_dev);
+	wanted_features = real_dev->wanted_features;
+	real_dev->wanted_features = real_dev->features;
+	real_dev->wanted_features &= ~mutable;
+	real_dev->wanted_features |= features & mutable;
+	netdev_update_features(real_dev);
+	real_dev->wanted_features = wanted_features;
+	real_dev->wanted_features &= ~mutable;
+	real_dev->wanted_features |= features & mutable;
+	if ((real_dev->features & mutable) != (features & mutable))
+		err = -EOPNOTSUPP;
+	netdev_unlock_ops(real_dev);
