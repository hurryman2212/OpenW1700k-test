+static void bond_ipsec_lag_flush_pending(struct bonding *bond)
+{
+	struct bond_ipsec *ipsec, *tmp;
+
+	lockdep_assert_held(&bond->ipsec_lock);
+
+	list_for_each_entry_safe(ipsec, tmp, &bond->ipsec_list, list) {
+		struct xfrm_state *xs = ipsec->xs;
+		struct net *net;
+		bool pending;
+
+		if (!ipsec->lag)
+			continue;
+
+		net = xs_net(xs);
+		spin_lock_bh(&net->xfrm.xfrm_state_lock);
+		pending = hlist_unhashed(&xs->bydst) &&
+			  xs->km.state != XFRM_STATE_DEAD;
+		if (pending)
+			xs->km.state = XFRM_STATE_DEAD;
+		spin_unlock_bh(&net->xfrm.xfrm_state_lock);
+		if (!pending)
+			continue;
+
+		list_del(&ipsec->list);
+		ipsec->real_ops->xdo_dev_state_delete(ipsec->real_dev, xs);
+		ipsec->real_ops->xdo_dev_state_free(ipsec->real_dev, xs);
+		WRITE_ONCE(xs->xso.real_dev, NULL);
+		WRITE_ONCE(xs->xso.real_ops, NULL);
+		WRITE_ONCE(xs->xso.offload_handle, 0);
+		dev_put(ipsec->real_dev);
+		kfree(ipsec);
+	}
