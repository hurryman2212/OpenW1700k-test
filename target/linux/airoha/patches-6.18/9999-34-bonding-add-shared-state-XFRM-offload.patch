+		return -EOPNOTSUPP;
+	}
+	if (lag && (xs->xso.flags & XFRM_DEV_OFFLOAD_FLAG_ACQ)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "LAG does not support acquire offload states");
+		return -EOPNOTSUPP;
