-static struct net_device *bond_ipsec_dev(struct xfrm_state *xs)
+static bool bond_ipsec_slave_has_xfrm_ops(struct net_device *real_dev)
 {
-	struct net_device *bond_dev = xs->xso.dev;
-	struct bonding *bond;
-	struct slave *slave;
+	const struct xfrmdev_ops *ops;
 
-	bond = netdev_priv(bond_dev);
-	if (BOND_MODE(bond) != BOND_MODE_ACTIVEBACKUP)
-		return NULL;
+	if (!real_dev || netif_is_bond_master(real_dev))
+		return false;
 
-	slave = rcu_dereference(bond->curr_active_slave);
-	if (!slave)
-		return NULL;
+	ops = READ_ONCE(real_dev->xfrmdev_ops);
 
-	if (!xs->xso.real_dev)
-		return NULL;
+	return ops && ops->xdo_dev_state_add &&
+	       ops->xdo_dev_state_delete && ops->xdo_dev_state_free;
+}
 
-	if (xs->xso.real_dev != slave->dev)
-		pr_warn_ratelimited("%s: (slave %s): not same with IPsec offload real dev %s\n",
-				    bond_dev->name, slave->dev->name, xs->xso.real_dev->name);
+static bool bond_ipsec_lag_slave_capable(struct net_device *real_dev)
+{
+	const struct xfrmdev_ops *ops;
 
-	return slave->dev;
+	if (!bond_ipsec_slave_has_xfrm_ops(real_dev) ||
+	    !((READ_ONCE(real_dev->features) |
+	       READ_ONCE(real_dev->hw_features)) & NETIF_F_HW_ESP))
+		return false;
+
+	ops = READ_ONCE(real_dev->xfrmdev_ops);
+
+	return (ops->flags & (XFRMDEV_OPS_F_LOWER_HANDLE |
+			      XFRMDEV_OPS_F_LAG_SHARED_STATE)) ==
+		       (XFRMDEV_OPS_F_LOWER_HANDLE |
+			XFRMDEV_OPS_F_LAG_SHARED_STATE) &&
+	       ops->xdo_dev_state_lag_compatible;
+}
+
+static bool bond_ipsec_lag_slave_ok(struct net_device *real_dev)
+{
+	return bond_ipsec_lag_slave_capable(real_dev) &&
+	       (READ_ONCE(real_dev->features) & NETIF_F_HW_ESP);
+}
+
+static bool bond_ipsec_lag_pair_capable(struct net_device *real_dev,
+					struct net_device *peer_dev)
+{
+	const struct xfrmdev_ops *peer_ops;
+	const struct xfrmdev_ops *ops;
+
+	if (!bond_ipsec_lag_slave_capable(real_dev) ||
+	    !bond_ipsec_lag_slave_capable(peer_dev))
+		return false;
+
+	ops = READ_ONCE(real_dev->xfrmdev_ops);
+	peer_ops = READ_ONCE(peer_dev->xfrmdev_ops);
+
+	return ops->xdo_dev_state_lag_compatible(real_dev, peer_dev) &&
+	       peer_ops->xdo_dev_state_lag_compatible(peer_dev, real_dev);
+}
+
+static bool bond_ipsec_lag_pair_ok(struct net_device *real_dev,
+				   struct net_device *peer_dev)
+{
+	return bond_ipsec_lag_slave_ok(real_dev) &&
+	       bond_ipsec_lag_slave_ok(peer_dev) &&
+	       bond_ipsec_lag_pair_capable(real_dev, peer_dev);
+}
+
+static u32 bond_ipsec_xfrm_hash(const struct xfrm_state *xs)
+{
+	u32 hash = (__force u32)xs->id.spi ^ xs->id.proto ^ xs->props.family;
+
+	if (xs->props.family == AF_INET) {
+		hash ^= (__force u32)xs->id.daddr.a4;
+		hash ^= (__force u32)xs->props.saddr.a4;
+	} else if (xs->props.family == AF_INET6) {
+		const __be32 *daddr = xs->id.daddr.a6;
+		const __be32 *saddr = xs->props.saddr.a6;
+		int i;
+
+		for (i = 0; i < 4; i++)
+			hash ^= (__force u32)daddr[i] ^ (__force u32)saddr[i];
+	}
+
+	if (xs->encap) {
+		hash ^= (__force u16)xs->encap->encap_sport << 16;
+		hash ^= (__force u16)xs->encap->encap_dport;
+	}
+
+	hash ^= hash >> 16;
+	hash ^= hash >> 8;
+
+	return hash;
+}
+
+static struct net_device *
+bond_ipsec_lag_select_dev(struct bonding *bond, struct xfrm_state *xs)
+{
+	struct bond_up_slave *slaves;
+	struct net_device *real_dev;
+	unsigned int count;
+	unsigned int start;
+	unsigned int i;
+
+	rcu_read_lock();
+	slaves = rcu_dereference(bond->usable_slaves);
+	count = slaves ? READ_ONCE(slaves->count) : 0;
+	if (!count)
+		goto out_none;
+
+	start = bond_ipsec_xfrm_hash(xs) % count;
+	real_dev = slaves->arr[start]->dev;
+	if (!bond_ipsec_lag_slave_ok(real_dev))
+		goto out_none;
+
+	for (i = 0; i < count; i++) {
+		struct net_device *peer_dev = slaves->arr[i]->dev;
+
+		if (!bond_ipsec_lag_pair_ok(real_dev, peer_dev))
+			goto out_none;
+	}
+
+	dev_hold(real_dev);
+	rcu_read_unlock();
+
+	return real_dev;
+
+out_none:
+	rcu_read_unlock();
+	return NULL;
+}
+
+static bool bond_ipsec_lag_ready(struct bonding *bond)
+{
+	struct bond_up_slave *slaves;
+	struct net_device *real_dev;
+	unsigned int count;
+	unsigned int i;
+	bool ready = false;
+
+	rcu_read_lock();
+	slaves = rcu_dereference(bond->usable_slaves);
+	count = slaves ? READ_ONCE(slaves->count) : 0;
+	if (!count)
+		goto out;
+
+	real_dev = slaves->arr[0]->dev;
+	for (i = 0; i < count; i++) {
+		if (!bond_ipsec_lag_pair_ok(real_dev, slaves->arr[i]->dev))
+			goto out;
+	}
+	ready = true;
+out:
+	rcu_read_unlock();
+
+	return ready;
 }
 
