 	}
-out:
-	netdev_put(real_dev, &tracker);
+	if (!real_dev) {
+		err = -ENODEV;
+		NL_SET_ERR_MSG_MOD(extack, "No eligible IPsec offload slave");
+		goto err_unlock;
