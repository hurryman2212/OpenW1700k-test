+	if (lag && (xs->props.flags & XFRM_STATE_ESN)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "LAG does not support XFRM ESN offload");
+		return -EOPNOTSUPP;
 	}
 
-	ipsec = kmalloc(sizeof(*ipsec), GFP_KERNEL);
-	if (!ipsec) {
-		err = -ENOMEM;
-		goto out;
+	ipsec = kmalloc_obj(*ipsec);
+	if (!ipsec)
