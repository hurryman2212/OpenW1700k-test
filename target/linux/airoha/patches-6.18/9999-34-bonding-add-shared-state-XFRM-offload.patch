+	real_ops = READ_ONCE(real_dev->xfrmdev_ops);
+	WRITE_ONCE(xs->xso.real_dev, real_dev);
+	WRITE_ONCE(xs->xso.real_ops, real_ops);
+	WRITE_ONCE(xs->xso.offload_handle, 0);
+	err = real_ops->xdo_dev_state_add(real_dev, xs, extack);
