+		WRITE_ONCE(ipsec->xs->xso.real_ops, real_ops);
+		WRITE_ONCE(ipsec->xs->xso.offload_handle, 0);
+		if (real_ops->xdo_dev_state_add(real_dev, ipsec->xs, NULL)) {
 			slave_warn(bond_dev, real_dev, "%s: failed to add SA\n", __func__);
+			WRITE_ONCE(ipsec->xs->xso.real_dev, NULL);
+			WRITE_ONCE(ipsec->xs->xso.real_ops, NULL);
+			WRITE_ONCE(ipsec->xs->xso.offload_handle, 0);
+			dev_put(real_dev);
 			continue;
 		}
 
