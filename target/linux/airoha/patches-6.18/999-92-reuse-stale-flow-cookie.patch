+#ifdef CONFIG_NET_SWITCHDEV
+	/* DIAG (999-92): visibility on the FLOW_CLS_REPLACE path.
+	 * Throttle to 1/s; reports count of replace events in the
+	 * last 1 s window plus how many found a stale cookie.  A
+	 * non-zero stale count means the SW flow_offload core
+	 * recycled a cookie this driver still had on record.
+	 */
+	{
+		static unsigned long diag_replace_last;
+		static u32 diag_replace_count, diag_replace_stale;
+
+		diag_replace_count++;
+		if (e != NULL)
+			diag_replace_stale++;
+		if (time_after(jiffies, diag_replace_last + HZ)) {
+			pr_info("DIAG REPLACE: %u/s stale=%u\n",
+				diag_replace_count, diag_replace_stale);
+			diag_replace_last = jiffies;
+			diag_replace_count = 0;
+			diag_replace_stale = 0;
+		}
+	}
+#endif
 
