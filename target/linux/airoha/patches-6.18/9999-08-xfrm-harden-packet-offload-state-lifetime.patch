From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Tue, 4 Aug 2026 16:29:39 +0900
Subject: [PATCH] xfrm: harden packet offload state lifetime

Keep packet-offloaded XFRM state lifetime and teardown synchronized.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 net/xfrm/xfrm_state.c | 359 +++++++++++++++++++++++++++++++++++-------
 1 file changed, 300 insertions(+), 59 deletions(-)

diff --git a/net/xfrm/xfrm_state.c b/net/xfrm/xfrm_state.c
index 89daad5..d63d689 100644
--- a/net/xfrm/xfrm_state.c
+++ b/net/xfrm/xfrm_state.c
@@ -15,6 +15,7 @@
  */
 
 #include <linux/compat.h>
+#include <linux/wait_bit.h>
 #include <linux/workqueue.h>
 #include <net/xfrm.h>
 #include <linux/pfkeyv2.h>
@@ -58,6 +59,33 @@ static inline bool xfrm_state_hold_rcu(struct xfrm_state __rcu *x)
 	return refcount_inc_not_zero(&x->refcnt);
 }
 
+/* Called with net->xfrm.xfrm_state_lock held. */
+static bool xfrm_dev_state_offload_active(struct xfrm_state *x)
+{
+	lockdep_assert_held(&xs_net(x)->xfrm.xfrm_state_lock);
+
+#ifdef CONFIG_XFRM_OFFLOAD
+	const struct xfrmdev_ops *ops;
+	struct net_device *dev;
+
+	if (x->xso.type != XFRM_DEV_OFFLOAD_PACKET)
+		return true;
+
+	dev = READ_ONCE(x->xso.dev);
+	if (!dev || !net_eq(dev_net(dev), xs_net(x)) ||
+	    READ_ONCE(dev->reg_state) != NETREG_REGISTERED ||
+	    READ_ONCE(dev->moving_ns) ||
+	    !(READ_ONCE(dev->features) & NETIF_F_HW_ESP))
+		return false;
+
+	ops = READ_ONCE(dev->xfrmdev_ops);
+	return ops && ops == READ_ONCE(x->xso.state_ops) &&
+	       ops->xdo_dev_state_add;
+#else
+	return true;
+#endif
+}
+
 static inline unsigned int xfrm_dst_hash(struct net *net,
 					 const xfrm_address_t *daddr,
 					 const xfrm_address_t *saddr,
@@ -737,6 +765,7 @@ struct xfrm_state *xfrm_state_alloc(struct net *net)
 	if (x) {
 		write_pnet(&x->xs_net, net);
 		refcount_set(&x->refcnt, 1);
+		atomic_set(&x->xso.active_refs, 0);
 		atomic_set(&x->tunnel_users, 0);
 		INIT_LIST_HEAD(&x->km.all);
 		INIT_HLIST_NODE(&x->state_cache);
@@ -763,37 +792,93 @@ struct xfrm_state *xfrm_state_alloc(struct net *net)
 EXPORT_SYMBOL(xfrm_state_alloc);
 
 #ifdef CONFIG_XFRM_OFFLOAD
-void xfrm_dev_state_delete(struct xfrm_state *x)
+static struct net_device *
+xfrm_dev_state_delete_prepare(struct xfrm_state *x,
+			      const struct xfrmdev_ops **ops)
 {
 	struct xfrm_dev_offload *xso = &x->xso;
-	struct net_device *dev = READ_ONCE(xso->dev);
+	struct net_device *dev;
+
+	if (WARN_ON_ONCE(!atomic_inc_unless_negative(&xso->active_refs)))
+		return NULL;
+	xfrm_state_hold(x);
+	dev = READ_ONCE(xso->dev);
+	if (!dev) {
+		xfrm_dev_offload_put(x);
+		return NULL;
+	}
 
-	if (dev) {
-		dev->xfrmdev_ops->xdo_dev_state_delete(dev, x);
-		spin_lock_bh(&xfrm_state_dev_gc_lock);
-		hlist_add_head(&x->dev_gclist, &xfrm_state_dev_gc_list);
+	/* Keep device-private state alive until its delete callback returns. */
+	spin_lock_bh(&xfrm_state_dev_gc_lock);
+	if (!hlist_unhashed(&x->dev_gclist)) {
 		spin_unlock_bh(&xfrm_state_dev_gc_lock);
+		xfrm_dev_offload_put(x);
+		return NULL;
 	}
+	hlist_add_head(&x->dev_gclist, &xfrm_state_dev_gc_list);
+	spin_unlock_bh(&xfrm_state_dev_gc_lock);
+	*ops = READ_ONCE(xso->state_ops);
+
+	return dev;
+}
+
+static void xfrm_dev_state_delete_finish(struct xfrm_state *x,
+					 struct net_device *dev,
+					 const struct xfrmdev_ops *ops)
+{
+	if (ops && ops->xdo_dev_state_delete)
+		ops->xdo_dev_state_delete(dev, x);
+	xfrm_dev_offload_put(x);
+}
+
+void xfrm_dev_state_delete(struct xfrm_state *x)
+{
+	const struct xfrmdev_ops *ops = NULL;
+	struct net_device *dev;
+
+	dev = xfrm_dev_state_delete_prepare(x, &ops);
+	if (dev)
+		xfrm_dev_state_delete_finish(x, dev, ops);
 }
 EXPORT_SYMBOL_GPL(xfrm_dev_state_delete);
 
 void xfrm_dev_state_free(struct xfrm_state *x)
 {
+	const struct xfrmdev_ops *ops;
 	struct xfrm_dev_offload *xso = &x->xso;
-	struct net_device *dev = READ_ONCE(xso->dev);
+	struct net_device *dev;
 
-	if (dev && dev->xfrmdev_ops) {
-		spin_lock_bh(&xfrm_state_dev_gc_lock);
-		if (!hlist_unhashed(&x->dev_gclist))
-			hlist_del(&x->dev_gclist);
-		spin_unlock_bh(&xfrm_state_dev_gc_lock);
+	/* Negative active_refs grants one caller exclusive free ownership.
+	 * Contenders wait for the owner to finish before checking xso.dev again.
+	 */
+	for (;;) {
+		if (!atomic_cmpxchg(&xso->active_refs, 0, -1))
+			break;
 
-		if (dev->xfrmdev_ops->xdo_dev_state_free)
-			dev->xfrmdev_ops->xdo_dev_state_free(dev, x);
-		WRITE_ONCE(xso->dev, NULL);
-		xso->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
-		netdev_put(dev, &xso->dev_tracker);
+		wait_var_event(&xso->active_refs,
+			       !atomic_read(&xso->active_refs));
 	}
+
+	dev = READ_ONCE(xso->dev);
+	if (!dev)
+		goto release;
+
+	ops = READ_ONCE(xso->state_ops);
+	if (ops && ops->xdo_dev_state_free)
+		ops->xdo_dev_state_free(dev, x);
+
+	spin_lock_bh(&xfrm_state_dev_gc_lock);
+	if (!hlist_unhashed(&x->dev_gclist))
+		hlist_del_init(&x->dev_gclist);
+	WRITE_ONCE(xso->dev, NULL);
+	WRITE_ONCE(xso->state_ops, NULL);
+	xso->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
+	spin_unlock_bh(&xfrm_state_dev_gc_lock);
+	netdev_put(dev, &xso->dev_tracker);
+
+release:
+	atomic_set_release(&xso->active_refs, 0);
+	wake_up_var(&xso->active_refs);
 }
 #endif
 
