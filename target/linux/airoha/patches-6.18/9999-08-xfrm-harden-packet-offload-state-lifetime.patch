@@ -2314,6 +2485,17 @@ int xfrm_state_check_expire(struct xfrm_state *x)
 }
 EXPORT_SYMBOL(xfrm_state_check_expire);
 
+void xfrm_state_expire(struct xfrm_state *x)
+{
+	spin_lock_bh(&x->lock);
+	if (x->km.state == XFRM_STATE_VALID) {
+		x->km.state = XFRM_STATE_EXPIRED;
+		hrtimer_start(&x->mtimer, 0, HRTIMER_MODE_REL_SOFT);
+	}
+	spin_unlock_bh(&x->lock);
+}
+EXPORT_SYMBOL_GPL(xfrm_state_expire);
+
 void xfrm_state_update_stats(struct net *net)
 {
 	struct xfrm_state *x;
@@ -2740,6 +2922,62 @@ static void xfrm_replay_timer_handler(struct timer_list *t)
 
 static LIST_HEAD(xfrm_km_list);
 
+u32 xfrm_policy_generation(const struct net *net)
+{
+	return atomic_read(&net->xfrm.policy_genid);
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_generation);
+
+bool xfrm_policy_flowtable_eligible(const struct net *net)
+{
+	return !atomic_read(&net->xfrm.policy_change_count) &&
+	       !atomic_read(&net->xfrm.policy_flowtable_unsafe);
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_flowtable_eligible);
+
+static void xfrm_policy_generation_advance(struct net *net)
+{
+	/* Generation zero means that no authenticated policy snapshot is
+	 * attached to a flow, so skip it when the counter eventually wraps.
+	 */
+	if (!atomic_inc_return(&net->xfrm.policy_genid))
+		atomic_inc(&net->xfrm.policy_genid);
+}
+
+void xfrm_policy_change_begin(struct net *net)
+{
+	struct xfrm_mgr *km;
+
+	lockdep_assert_held(&net->xfrm.xfrm_policy_lock);
+	xfrm_policy_generation_advance(net);
+	if (atomic_inc_return(&net->xfrm.policy_change_count) != 1)
+		return;
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(km, &xfrm_km_list, list)
+		if (km->policy_change_begin)
+			km->policy_change_begin(net);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_change_begin);
+
+void xfrm_policy_change_end(struct net *net)
+{
+	struct xfrm_mgr *km;
+
+	lockdep_assert_held(&net->xfrm.xfrm_policy_lock);
+	xfrm_policy_generation_advance(net);
+	if (!atomic_dec_and_test(&net->xfrm.policy_change_count))
+		return;
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(km, &xfrm_km_list, list)
+		if (km->policy_changed)
+			km->policy_changed(net);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(xfrm_policy_change_end);
+
 void km_policy_notify(struct xfrm_policy *xp, int dir, const struct km_event *c)
