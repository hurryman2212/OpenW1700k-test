+static int airoha_ppe_foe_invalidate_entry(struct airoha_ppe *ppe,
+					   struct airoha_foe_entry *hwe,
+					   u32 hash)
 {
 	u32 sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+	u32 ib1 = hwe->ib1;
+	int err;
 
 	hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
-	hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
-				  AIROHA_FOE_STATE_INVALID);
-	/* Publish the invalid state before asking PPE to copy it into SRAM. */
+	hwe->ib1 |=
+		FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE, AIROHA_FOE_STATE_INVALID);
+	/* Publish INVALID state before copying the entry into SRAM. */
 	wmb();
 
-	return hash < sram_num_entries ?
-		airoha_ppe_foe_commit_sram_entry(ppe, hash) : 0;
+	err = hash < sram_num_entries ?
+		      airoha_ppe_foe_commit_sram_entry(ppe, hash) :
+		      0;
+	if (err) {
+		hwe->ib1 = ib1;
+		/* Restore the software mirror before releasing the PPE lock. */
+		wmb();
+	}
+
+	return err;
+}
+
+static int airoha_ppe_foe_hold_entry(struct airoha_ppe *ppe,
+				     struct airoha_flow_table_entry *e,
+				     struct airoha_foe_entry *hwe, u32 hash)
+{
+	u32 state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+
+	if (state == AIROHA_FOE_STATE_INVALID) {
+		memcpy(&hwe->d, &e->data.d, sizeof(*hwe) - sizeof(hwe->ib1));
+		/* Publish the held tuple before its INVALID state word. */
+		wmb();
+		hwe->ib1 = e->data.ib1 & ~AIROHA_FOE_IB1_BIND_STATE;
+		hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+				       AIROHA_FOE_STATE_INVALID);
+	}
+
+	return airoha_ppe_foe_invalidate_entry(ppe, hwe, hash);
 }
 
