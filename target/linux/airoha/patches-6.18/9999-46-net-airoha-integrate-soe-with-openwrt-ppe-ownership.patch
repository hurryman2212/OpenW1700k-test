From d2bdf67ceb6453d076a101123c348bc5ff126469 Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Thu, 23 Jul 2026 03:29:02 +0900
Subject: [PATCH] net: airoha: integrate SOE with OpenWrt PPE ownership

OpenWrt tracks the current owner of each FOE hash so delayed teardown
cannot invalidate a replacement flow. Preserve that contract while SOE
temporarily holds learned entries unbound, commits them after the SA
drains, or rolls back a failed hardware write. Wait for RCU readers
before tearing down the NPU used by PPE commits.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_ppe.c | 324 +++++++++++++++++------
 1 file changed, 249 insertions(+), 75 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 2bb2c7a..648c882 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -138,6 +138,16 @@ static bool airoha_ppe_soe_quiesce_locked(struct airoha_ppe *ppe)
 	return true;
 }
 
+static void airoha_ppe_soe_fail_locked(struct airoha_ppe *ppe,
+				       const char *reason)
+{
+	lockdep_assert_held(&ppe_lock);
+
+	if (airoha_ppe_soe_quiesce_locked(ppe))
+		dev_err_ratelimited(ppe->eth->dev,
+				    "%s; disabling IPsec PPE path\n", reason);
+}
+
 bool airoha_ppe_soe_quiesce(struct airoha_eth *eth)
 {
 	struct airoha_ppe *ppe;
@@ -987,6 +997,30 @@ static bool airoha_ppe_foe_compare_entry(struct airoha_flow_table_entry *e,
 	return !memcmp(&e->data.d, &hwe->d, len - sizeof(hwe->ib1));
 }
 
+static void
+airoha_ppe_foe_claim_entry(struct airoha_ppe *ppe,
+			   struct airoha_flow_table_entry *e, u32 hash)
+{
+	struct airoha_flow_table_entry *iter;
+	struct hlist_node *n;
+
+	lockdep_assert_held(&ppe_lock);
+
+	hlist_for_each_entry_safe(iter, n, &ppe->foe_flow[hash], list) {
+		if (iter == e || iter->hash != hash)
+			continue;
+
+		iter->hash = 0xffff;
+		if (iter->type != FLOW_TYPE_L2_SUBFLOW)
+			continue;
+
+		hlist_del_init(&iter->l2_subflow_node);
+		hlist_del_init(&iter->list);
+		kfree(iter);
+	}
+	e->hash = hash;
+}
