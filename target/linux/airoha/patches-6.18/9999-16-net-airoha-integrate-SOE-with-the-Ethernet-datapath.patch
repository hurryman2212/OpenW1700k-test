From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Tue, 4 Aug 2026 16:29:39 +0900
Subject: [PATCH] net: airoha: integrate SOE with the Ethernet datapath

Connect SOE packets, completions and feature handling to the Airoha Ethernet datapath.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 928 ++++++++++++++++++++---
 1 file changed, 835 insertions(+), 93 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index cca9f5d..e51d4c0 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -10,6 +10,7 @@
 #include <linux/tcp.h>
 #include <linux/pcs/pcs.h>
 #include <linux/u64_stats_sync.h>
+#include <linux/udp.h>
 #include <net/dst_metadata.h>
 #include <net/ip6_checksum.h>
 #include <net/page_pool/helpers.h>
@@ -19,6 +20,31 @@
 
 #include "airoha_regs.h"
 #include "airoha_eth.h"
+#include "airoha_soe.h"
+
+/* QDMA1 uses a different RX IRQ bank layout than QDMA0 on EN7581. */
+#define AIROHA_QDMA_WAN_RX_IRQ0_BANK_PIN_MASK 0x0000839f
+#define AIROHA_QDMA_WAN_RX_IRQ1_BANK_PIN_MASK 0x7f800400
+#define AIROHA_QDMA_WAN_RX_IRQ2_BANK_PIN_MASK 0x00000000
+#define AIROHA_QDMA_WAN_RX_IRQ3_BANK_PIN_MASK 0x00000040
+
+static unsigned int airoha_qdma0_rx_irq_bank_mask[AIROHA_MAX_NUM_IRQ_BANKS] = {
+	RX_IRQ0_BANK_PIN_MASK,
+	RX_IRQ1_BANK_PIN_MASK,
+	RX_IRQ2_BANK_PIN_MASK,
+	RX_IRQ3_BANK_PIN_MASK,
+};
+
+static unsigned int airoha_qdma1_rx_irq_bank_mask[AIROHA_MAX_NUM_IRQ_BANKS] = {
+	AIROHA_QDMA_WAN_RX_IRQ0_BANK_PIN_MASK,
+	AIROHA_QDMA_WAN_RX_IRQ1_BANK_PIN_MASK,
+	AIROHA_QDMA_WAN_RX_IRQ2_BANK_PIN_MASK,
+	AIROHA_QDMA_WAN_RX_IRQ3_BANK_PIN_MASK,
+};
+
+#if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
+#define AIROHA_SOE_RX_RING 10
+#endif
 
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
@@ -74,6 +100,104 @@ static void airoha_qdma_irq_disable(struct airoha_irq_bank *irq_bank,
 	airoha_qdma_set_irqmask(irq_bank, index, mask, 0);
 }
 
+static unsigned int *airoha_qdma_rx_irq_bank_masks(struct airoha_qdma *qdma)
+{
+	struct airoha_eth *eth = qdma->eth;
+	int id = qdma - &eth->qdma[0];
+
+	return id ? airoha_qdma1_rx_irq_bank_mask :
+		    airoha_qdma0_rx_irq_bank_mask;
+}
+
+static u32 airoha_qdma_rx_irq_bank_mask(struct airoha_qdma *qdma, int bank)
+{
+	unsigned int *masks = airoha_qdma_rx_irq_bank_masks(qdma);
+
+	if (bank < 0 || bank >= AIROHA_MAX_NUM_IRQ_BANKS)
+		return 0;
+
+	return READ_ONCE(masks[bank]);
+}
+
+#if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
+static u32 airoha_qdma_rx_irq_all_bank_mask(struct airoha_qdma *qdma)
+{
+	u32 mask = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++)
+		mask |= airoha_qdma_rx_irq_bank_mask(qdma, i);
+
+	return mask;
+}
+#endif
+
+static void airoha_qdma_apply_rx_irq_bank_masks(struct airoha_qdma *qdma)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++) {
+		struct airoha_irq_bank *irq_bank = &qdma->irq_banks[i];
+		u32 mask = airoha_qdma_rx_irq_bank_mask(qdma, i);
+
+		airoha_qdma_set_irqmask(irq_bank, QDMA_INT_REG_IDX0,
+					RX_COHERENT_LOW_INT_MASK,
+					INT_RX0_MASK(mask));
+		airoha_qdma_set_irqmask(irq_bank, QDMA_INT_REG_IDX1,
+					RX_NO_CPU_DSCP_LOW_INT_MASK |
+						RX_DONE_LOW_INT_MASK,
+					INT_RX1_MASK(mask));
+		airoha_qdma_set_irqmask(irq_bank, QDMA_INT_REG_IDX2,
+					RX_NO_CPU_DSCP_HIGH_INT_MASK |
+						RX_DONE_HIGH_INT_MASK,
+					INT_RX2_MASK(mask));
+		airoha_qdma_set_irqmask(irq_bank, QDMA_INT_REG_IDX3,
+					RX_COHERENT_HIGH_INT_MASK,
+					INT_RX3_MASK(mask));
+	}
+}
+
+static void airoha_qdma_set_rx_irq(struct airoha_qdma *qdma, int qid,
+				   bool enable)
+{
+	int i, intr_reg;
+	u32 mask;
+
+	if (qid < RX_DONE_HIGH_OFFSET) {
+		intr_reg = QDMA_INT_REG_IDX1;
+		mask = INT_RX1_MASK(BIT(qid));
+	} else {
+		intr_reg = QDMA_INT_REG_IDX2;
+		mask = INT_RX2_MASK(BIT(qid));
+	}
+
+	for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++) {
+		if (!(BIT(qid) & airoha_qdma_rx_irq_bank_mask(qdma, i)))
+			continue;
+
+		if (enable)
+			airoha_qdma_irq_enable(&qdma->irq_banks[i], intr_reg,
+					       mask);
+		else
+			airoha_qdma_irq_disable(&qdma->irq_banks[i], intr_reg,
+						mask);
+	}
+
+#if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
+	if (qid != AIROHA_SOE_RX_RING || !qdma->eth->soe_present)
+		return;
+
+	if (BIT(qid) & airoha_qdma_rx_irq_all_bank_mask(qdma))
+		return;
+
+	/* The SOE RX ring may not be covered by the shared bank mask. */
+	if (enable)
+		airoha_qdma_irq_enable(&qdma->irq_banks[0], intr_reg, mask);
+	else
+		airoha_qdma_irq_disable(&qdma->irq_banks[0], intr_reg, mask);
+#endif
+}
+
 static int airoha_set_macaddr(struct airoha_gdm_dev *dev, const u8 *addr)
 {
 	u8 ref_addr[ETH_ALEN] __aligned(2);
@@ -561,8 +685,147 @@ static void airoha_dev_lro_enable(struct airoha_gdm_dev *dev)
 	}
 }
 
+enum airoha_fe_ifc_table {
+	AIROHA_FE_IFC_TCAM,
+	AIROHA_FE_IFC_LUT1,
+	AIROHA_FE_IFC_ACTION,
+};
+
+enum airoha_fe_ifc_command {
+	AIROHA_FE_IFC_WRITE = 1,
+	AIROHA_FE_IFC_CLEAR,
+};
+
+static int airoha_fe_ifc_request(struct airoha_eth *eth, u32 id, u32 offset,
+				 enum airoha_fe_ifc_table table,
+				 enum airoha_fe_ifc_command command)
+{
+	u32 val;
+
+	val = FIELD_PREP(FE_IFC_CTRL_ID_MASK, id) |
+	      FIELD_PREP(FE_IFC_CTRL_OFFSET_MASK, offset) |
+	      FIELD_PREP(FE_IFC_CTRL_TABLE_MASK, table) |
+	      FIELD_PREP(FE_IFC_CTRL_CMD_MASK, command) |
+	      FE_IFC_CTRL_REQ_MASK;
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_CTRL, val);
+
+	return read_poll_timeout(airoha_fe_rr, val, val & FE_IFC_CTRL_ACK_MASK,
+				 USEC_PER_MSEC, 5 * USEC_PER_MSEC, false, eth,
+				 REG_FE_CSR_IFC_CTRL);
+}
+
+static int airoha_fe_ifc_setup_natt(struct airoha_eth *eth)
+{
+	static const u32 tcam_key[9] = {
+		[0] = FIELD_PREP_CONST(FE_IFC_TCAM_RULE_TYPE_MASK, 1) |
+		      FE_IFC_TCAM_IPV4_VALID_MASK,
+		[2] = FIELD_PREP_CONST(FE_IFC_TCAM_DPORT_MASK, 4500),
+		[4] = BIT(0) | BIT(1),
+		[7] = FIELD_PREP_CONST(FE_IFC_TCAM_IPV4_PROTOCOL_MASK,
+				       IPPROTO_UDP),
+	};
+	static const u32 tcam_mask[9] = {
+		[0] = FE_IFC_TCAM_RULE_TYPE_MASK | FE_IFC_TCAM_IPV4_VALID_MASK,
+		[2] = FE_IFC_TCAM_DPORT_MASK,
+		[4] = BIT(0) | BIT(1),
+		[7] = FE_IFC_TCAM_IPV4_PROTOCOL_MASK,
+	};
+	u32 val;
+	int err, i;
+
+	err = airoha_fe_ifc_request(eth, 0, 0, AIROHA_FE_IFC_TCAM,
+				    AIROHA_FE_IFC_CLEAR);
+	if (err)
+		return err;
+
+	err = airoha_fe_ifc_request(eth, 0, 0, AIROHA_FE_IFC_LUT1,
+				    AIROHA_FE_IFC_CLEAR);
+	if (err)
+		return err;
+
+	/* The table-wide clear command does not clear the action SRAM. Disable
+	 * every entry before enabling IFC because its reset contents are not
+	 * defined.
+	 */
+	for (i = 0; i < 4; i++)
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(i), 0);
+
+	for (i = 0; i < FE_IFC_TCAM_NUM_ENTRIES; i++) {
+		err = airoha_fe_ifc_request(eth, i, 2, AIROHA_FE_IFC_ACTION,
+					    AIROHA_FE_IFC_WRITE);
+		if (err)
+			return err;
+	}
+
+	/* Match the complete four-byte RFC 3948 Non-ESP Marker. Each IFC UDF
+	 * covers two bytes, starting at the UDP payload.
+	 */
+	val = FIELD_PREP(FE_IFC_UDF0_BASE_MASK, 2) |
+	      FIELD_PREP(FE_IFC_UDF0_OFFSET_MASK, sizeof(struct udphdr)) |
+	      FIELD_PREP(FE_IFC_UDF1_BASE_MASK, 2) |
+	      FIELD_PREP(FE_IFC_UDF1_OFFSET_MASK,
+			 sizeof(struct udphdr) + sizeof(u16));
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_UDF(0), val);
+
+	for (i = 0; i < 2; i++) {
+		val = FIELD_PREP(FE_IFC_LUT1_MASK_MASK, U16_MAX);
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), val);
+		val = FIELD_PREP(FE_IFC_LUT1_FIELD_MASK, 32 + i) |
+		      FE_IFC_LUT1_RULE_VALID_MASK;
+		if (i == 1)
+			val |= FE_IFC_LUT1_RULE_END_MASK;
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), val);
+		err = airoha_fe_ifc_request(eth, i, 0, AIROHA_FE_IFC_LUT1,
+					    AIROHA_FE_IFC_WRITE);
+		if (err)
+			return err;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(tcam_key); i++) {
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), tcam_key[i]);
+		airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), tcam_mask[i]);
+		err = airoha_fe_ifc_request(eth, 0, 8 - i, AIROHA_FE_IFC_TCAM,
+					    AIROHA_FE_IFC_WRITE);
+		if (err)
+			return err;
+	}
+
+	/* Clear the complete action before enabling force-CPU on RX ring 1. */
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), 0);
+	err = airoha_fe_ifc_request(eth, 0, 0, AIROHA_FE_IFC_ACTION,
+				    AIROHA_FE_IFC_WRITE);
+	if (err)
+		return err;
+
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(2),
+		     FIELD_PREP(FE_IFC_ACT_NBQ_MASK, 1));
+	err = airoha_fe_ifc_request(eth, 0, 1, AIROHA_FE_IFC_ACTION,
+				    AIROHA_FE_IFC_WRITE);
+	if (err)
+		return err;
+
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(1), 0);
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(2), 0);
+	val = FE_IFC_ACT_FORCE_CPU_MASK | FE_IFC_ACT_RULE_END_MASK |
+	      FE_IFC_ACT_RULE_EN_MASK;
+	airoha_fe_wr(eth, REG_FE_CSR_IFC_DATA(0), val);
+	err = airoha_fe_ifc_request(eth, 0, 2, AIROHA_FE_IFC_ACTION,
+				    AIROHA_FE_IFC_WRITE);
+	if (err)
+		return err;
+
+	airoha_fe_set(eth, REG_FE_CSR_IFC_CFG, FE_IFC_EN_MASK);
+
+	return 0;
+}
+
 static int airoha_fe_init(struct airoha_eth *eth)
 {
+	int err;
+
 	airoha_fe_maccr_init(eth);
 
 	/* PSE IQ reserve */
@@ -607,6 +870,11 @@ static int airoha_fe_init(struct airoha_eth *eth)
 	airoha_fe_wr(eth, REG_FE_CDM1_OQ_MAP2, BIT(4));
 	airoha_fe_wr(eth, REG_FE_CDM1_OQ_MAP3, BIT(28));
 
+	/* SOE/TDMA output depends on PSE shared-buffer flow control instead
+	 * of leaving port-local sharing disabled.
+	 */
+	airoha_fe_clear(eth, REG_PSE_FC_CFG, PSE_TDMA_SHARE_BUF_DIS_MASK);
+
 	airoha_fe_vip_setup(eth);
 	airoha_fe_pse_ports_init(eth);
 
@@ -652,8 +920,18 @@ static int airoha_fe_init(struct airoha_eth *eth)
 		      FIELD_PREP(MBI_RX_AGE_SEL_MASK, 3) |
 		      FIELD_PREP(MBI_TX_AGE_SEL_MASK, 3));
 
-	/* disable IFC by default */
+	eth->natt_ifc_ready = false;
 	airoha_fe_clear(eth, REG_FE_CSR_IFC_CFG, FE_IFC_EN_MASK);
+	if (eth->soe_present) {
+		err = airoha_fe_ifc_setup_natt(eth);
+		if (err) {
+			dev_warn(eth->dev,
+				 "failed to configure NAT-T IFC; autonomous inbound NAT-T disabled: %d\n",
+				 err);
+		} else {
+			eth->natt_ifc_ready = true;
+		}
+	}
 
 	/* enable 1:N vlan action, init vlan table */
 	airoha_fe_set(eth, REG_MC_VLAN_EN, MC_VLAN_EN_MASK);
@@ -674,20 +952,29 @@ static int airoha_qdma_fill_rx_queue(struct airoha_queue *q)
 		int offset;
 		u32 val;
 
-		page = page_pool_dev_alloc_frag(q->page_pool, &offset,
-						q->buf_size);
-		if (!page)
-			break;
+		if (q->rx_coherent) {
+			/* Coherent slots avoid page_pool recycling for SOE frames. */
+			offset = q->head * q->buf_size;
+			e->buf = q->rx_coherent_buf + offset;
+			e->dma_addr = q->rx_coherent_dma + offset;
+			e->dma_len = q->buf_size;
+		} else {
+			page = page_pool_dev_alloc_frag(q->page_pool, &offset,
+							q->buf_size);
+			if (!page)
+				break;
+
+			offset += AIROHA_RX_HEADROOM;
+			e->buf = page_address(page) + offset;
+			e->dma_addr = page_pool_get_dma_addr(page) + offset;
+			e->dma_len =
+				SKB_WITH_OVERHEAD(AIROHA_RX_LEN(q->buf_size));
+		}
 
 		q->head = (q->head + 1) % q->ndesc;
 		q->queued++;
 		nframes++;
 
-		offset += AIROHA_RX_HEADROOM;
-		e->buf = page_address(page) + offset;
-		e->dma_addr = page_pool_get_dma_addr(page) + offset;
-		e->dma_len = SKB_WITH_OVERHEAD(AIROHA_RX_LEN(q->buf_size));
-
 		WRITE_ONCE(desc->tcp_ts_reply, 0);
 		val = FIELD_PREP(QDMA_DESC_LEN_MASK, e->dma_len);
 		WRITE_ONCE(desc->ctrl, cpu_to_le32(val));
@@ -889,81 +1176,246 @@ static struct sk_buff *airoha_qdma_build_rx_skb(struct airoha_queue *q,
 	return skb;
 }
 
-static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
+struct airoha_qdma_rx_cb {
+	u32 msg0;
+	u32 msg1;
+};
+
+static_assert(sizeof(struct airoha_qdma_rx_cb) <=
+	      sizeof_field(struct sk_buff, cb));
+
+static int airoha_qdma_rx_process(struct airoha_queue *q, int budget,
+				  int *desc_budget)
 {
-	enum dma_data_direction dir = page_pool_get_dma_dir(q->page_pool);
-	struct airoha_eth *eth = q->qdma->eth;
+	enum dma_data_direction dir;
+	struct airoha_qdma *qdma = q->qdma;
+	struct airoha_eth *eth = qdma->eth;
+	int qid = q - &qdma->q_rx[0];
 	int done = 0;
 
-	while (done < budget) {
+	dir = q->rx_coherent ? DMA_FROM_DEVICE :
+			       page_pool_get_dma_dir(q->page_pool);
+
+	while (q->queued > 0 && done < budget && *desc_budget > 0) {
 		struct airoha_queue_entry *e = &q->entry[q->tail];
 		struct airoha_qdma_desc *desc = &q->desc[q->tail];
-		u32 hash, reason, msg1, desc_ctrl;
-		struct airoha_gdm_dev *dev;
+		struct airoha_qdma_rx_cb *rx_cb;
+		u32 hash, reason, msg0, msg1, msg2, desc_ctrl;
+		struct airoha_gdm_dev *dev = NULL;
+#if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
+		struct net_device *rx_dev = NULL;
+#endif
 		struct net_device *netdev;
+		bool first_buf = !q->skb;
+		bool soe_ring = false;
+		bool soe_pkt = false;
 		int data_len, len;
-		struct page *page;
+		struct page *page = NULL;
 
 		desc_ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
 		if (!(desc_ctrl & QDMA_DESC_DONE_MASK))
 			break;
 
 		dma_rmb();
+		(*desc_budget)--;
 
 		q->tail = (q->tail + 1) % q->ndesc;
 		q->queued--;
 
-		dma_sync_single_for_cpu(eth->dev, e->dma_addr, e->dma_len,
-					dir);
+		if (!q->rx_coherent)
+			dma_sync_single_for_cpu(eth->dev, e->dma_addr,
+						e->dma_len, dir);
+
+		if (!q->rx_coherent)
+			page = virt_to_head_page(e->buf);
+
+		if (q->rx_drop_chain) {
+			if (!FIELD_GET(QDMA_DESC_MORE_MASK, desc_ctrl)) {
+				q->rx_drop_chain = false;
+				q->rx_frame_descs = 0;
+				done++;
+			}
+			if (!q->rx_coherent)
+				page_pool_put_full_page(q->page_pool, page, true);
+			continue;
+		}
+
+		msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
+		msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+		msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
+#if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
+		/* SOE completions can return on any RX ring. Only the first
+		 * descriptor is guaranteed to carry frame metadata.
+		 */
+		soe_ring = eth->soe_present && qid == AIROHA_SOE_RX_RING;
+#endif
+		if (unlikely(desc_ctrl & QDMA_DESC_DROP_MASK))
+			goto free_frag;
 
-		page = virt_to_head_page(e->buf);
 		len = FIELD_GET(QDMA_DESC_LEN_MASK, desc_ctrl);
-		data_len = q->skb ? AIROHA_RX_LEN(q->buf_size) : e->dma_len;
+		data_len = q->skb && !q->rx_coherent ?
+				   AIROHA_RX_LEN(q->buf_size) :
+				   e->dma_len;
 		if (!len || data_len < len)
 			goto free_frag;
-
-		dev = airoha_qdma_get_gdm_dev(eth, desc);
-		if (IS_ERR(dev))
+		if (soe_ring &&
+		    (len > AIROHA_MAX_RX_SIZE ||
+		     (q->skb && q->skb->len > AIROHA_MAX_RX_SIZE - len)))
 			goto free_frag;
+#if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
+		if (first_buf)
+			soe_pkt = airoha_soe_rx_is_completion(e->buf, len,
+							      msg0);
+		else
+			soe_pkt = !q->skb->dev;
+#endif
+
+		if (!soe_pkt) {
+			if (first_buf) {
+				dev = airoha_qdma_get_gdm_dev(eth, desc);
+				if (IS_ERR(dev))
+					goto free_frag;
+				netdev = netdev_from_priv(dev);
+			} else {
+				netdev = q->skb->dev;
+				dev = netdev_priv(netdev);
+				rx_cb = (void *)q->skb->cb;
+				msg0 = rx_cb->msg0;
+				msg1 = rx_cb->msg1;
+			}
+#if IS_REACHABLE(CONFIG_NET_AIROHA_SOE)
+			rx_dev = netdev;
+#endif
+		}
 
-		netdev = netdev_from_priv(dev);
 		if (!q->skb) { /* first buffer */
-			q->skb = airoha_qdma_build_rx_skb(q, desc, e, netdev);
+			if (q->rx_coherent) {
+				q->skb = napi_alloc_skb(&q->napi, len);
+				if (q->skb)
+					skb_put_data(q->skb, e->buf, len);
+			} else if (soe_pkt) {
+				void *buf = e->buf - AIROHA_RX_HEADROOM;
+
+				q->skb = napi_build_skb(buf, q->buf_size);
+				if (q->skb) {
+					skb_reserve(q->skb, AIROHA_RX_HEADROOM);
+					__skb_put(q->skb, len);
