From c1d87f6f21022b4e4106cf0e57f78abab3ed8abc Mon Sep 17 00:00:00 2001
From: Jihong Min <hurryman2212@gmail.com>
Date: Thu, 23 Jul 2026 01:48:29 +0900
Subject: [PATCH] net: airoha: add autonomous SOE XFRM flow offload

Program outbound SOE encryption hops and adopt authenticated learned
ESP or NAT-T entries for inbound decryption, with explicit quiesce and
invalidation across SA and policy changes.

Hold outbound entries unbound while active SOE contexts drain and share
one authenticated inbound hardware entry across flows using the same SA.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Jihong Min <hurryman2212@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_ppe.c | 1057 ++++++++++++++++++++--
 1 file changed, 1003 insertions(+), 54 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 4d76fe5..524fef2 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -9,12 +9,16 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/rhashtable.h>
+#include <linux/vmalloc.h>
 #include <net/ipv6.h>
+#include <net/netfilter/nf_flow_table.h>
 #include <net/pkt_cls.h>
 #include <net/route.h>
+#include <net/xfrm.h>
 
 #include "airoha_regs.h"
 #include "airoha_eth.h"
+#include "airoha_soe.h"
 
 /* Serialize airoha_gdm_dev flags, QDMA pointer and PPE CPU port
  * configuration.
@@ -22,6 +26,25 @@
 DEFINE_MUTEX(flow_offload_mutex);
 static DEFINE_SPINLOCK(ppe_lock);
 
+#define AIROHA_FOE_HOP0			GENMASK(31, 29)
+#define AIROHA_FOE_HOP1			GENMASK(28, 26)
+#define AIROHA_FOE_HOP2			GENMASK(25, 23)
+#define AIROHA_FOE_HOP3			GENMASK(22, 20)
+#define AIROHA_FOE_HOP_MASK					\
+	(AIROHA_FOE_HOP0 | AIROHA_FOE_HOP1 | AIROHA_FOE_HOP2 |\
+	 AIROHA_FOE_HOP3)
+#define AIROHA_PPE_SOE_DEFAULT_TUNNEL_MTU	1500
+#define AIROHA_PPE_SOE_MAGIC_IPSEC		0x72a1
+#define AIROHA_PPE_SOE_MAGIC_GDM4		0x729a
+#define AIROHA_PPE_SOE_PORT_AG			0x3f
+#define AIROHA_PPE_SOE_CHANNEL			2
+
+struct airoha_ppe_soe_info {
+	struct airoha_soe_ppe_info state;
+	u32 tunnel_mtu;
+	bool input;
+};
+
 static const struct rhashtable_params airoha_flow_table_params = {
 	.head_offset = offsetof(struct airoha_flow_table_entry, node),
 	.key_offset = offsetof(struct airoha_flow_table_entry, cookie),
@@ -82,6 +105,90 @@ bool airoha_ppe_is_enabled(struct airoha_eth *eth, int index)
 	return airoha_fe_rr(eth, REG_PPE_GLO_CFG(index)) & PPE_GLO_CFG_EN_MASK;
 }
 
+static void
+airoha_ppe_soe_set_enabled_locked(struct airoha_ppe *ppe, bool enable)
+{
+	struct airoha_eth *eth = ppe->eth;
+	u32 mask = PPE_FLOW_CFG_IP4_IPSEC_MASK;
+	int i;
+
+	lockdep_assert_held(&ppe_lock);
+
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		if (enable)
+			airoha_fe_set(eth, REG_PPE_PPE_FLOW_CFG(i), mask);
+		else
+			airoha_fe_clear(eth, REG_PPE_PPE_FLOW_CFG(i), mask);
+
+		/* Complete the MMIO write before a caller changes SA ownership. */
+		airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(i));
+	}
+}
+
+static bool airoha_ppe_soe_quiesce_locked(struct airoha_ppe *ppe)
+{
+	lockdep_assert_held(&ppe_lock);
+
+	if (WARN_ON_ONCE(ppe->soe_quiesce_count == UINT_MAX))
+		return false;
+	if (!ppe->soe_quiesce_count++)
+		airoha_ppe_soe_set_enabled_locked(ppe, false);
+
+	return true;
+}
+
+bool airoha_ppe_soe_quiesce(struct airoha_eth *eth)
+{
+	struct airoha_ppe *ppe;
+
+	if (!eth || !eth->ppe)
+		return false;
+
+	ppe = eth->ppe;
+	spin_lock_bh(&ppe_lock);
+	if (!airoha_ppe_soe_quiesce_locked(ppe)) {
+		spin_unlock_bh(&ppe_lock);
+		return false;
+	}
+	spin_unlock_bh(&ppe_lock);
+
+	return true;
+}
+
+void airoha_ppe_soe_resume(struct airoha_eth *eth)
+{
+	struct airoha_ppe *ppe;
+
+	if (!eth || !eth->ppe)
+		return;
+
+	ppe = eth->ppe;
+	spin_lock_bh(&ppe_lock);
+	if (WARN_ON_ONCE(!ppe->soe_quiesce_count))
+		goto unlock;
+
+	ppe->soe_quiesce_count--;
+	if (!ppe->soe_quiesce_count && rcu_access_pointer(eth->npu) &&
+	    airoha_soe_available(eth->soe))
+		airoha_ppe_soe_set_enabled_locked(ppe, true);
+unlock:
+	spin_unlock_bh(&ppe_lock);
+}
+
+bool airoha_ppe_soe_is_quiesced(struct airoha_eth *eth)
+{
+	bool quiesced;
+
+	if (!eth || !eth->ppe)
+		return true;
+
+	spin_lock_bh(&ppe_lock);
+	quiesced = !!eth->ppe->soe_quiesce_count;
+	spin_unlock_bh(&ppe_lock);
+
+	return quiesced;
+}
+
 static u32 airoha_ppe_get_timestamp(struct airoha_ppe *ppe)
 {
 	return airoha_fe_get(ppe->eth, REG_FE_FOE_TS,
@@ -197,6 +304,12 @@ static void airoha_ppe_hw_init(struct airoha_ppe *ppe)
 				PPE_FLOW_CFG_IP6_6RD_MASK);
 	}
 
+	spin_lock_bh(&ppe_lock);
+	airoha_ppe_soe_set_enabled_locked(ppe,
+					  !ppe->soe_quiesce_count &&
+					  airoha_soe_available(eth->soe));
+	spin_unlock_bh(&ppe_lock);
+
 	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
 		struct airoha_gdm_port *port = eth->ports[i];
 		int j;
@@ -534,6 +647,133 @@ static int airoha_ppe_foe_entry_set_ipv6_tuple(struct airoha_foe_entry *hwe,
 	return 0;
 }
 
+static int
+airoha_ppe_foe_entry_set_soe_fields(struct airoha_foe_entry *hwe,
+				    const struct airoha_ppe_soe_info *info)
+{
+	int type;
+
+	if (info->state.hop > FIELD_MAX(AIROHA_FOE_HOP0))
+		return -ERANGE;
+
+	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+	if (type != PPE_PKT_TYPE_IPV4_HNAPT &&
+	    type != PPE_PKT_TYPE_IPV4_ROUTE)
+		return -EOPNOTSUPP;
+
+	hwe->ipv4.rsv[0] &= ~AIROHA_FOE_HOP_MASK;
+	hwe->ipv4.rsv[0] |= FIELD_PREP(AIROHA_FOE_HOP0, info->state.hop);
+
+	hwe->ipv4.data &= ~(AIROHA_FOE_ACTDP | AIROHA_FOE_TUNNEL_ID);
+	hwe->ipv4.data |= AIROHA_FOE_TUNNEL |
+			  FIELD_PREP(AIROHA_FOE_ACTDP,
+				     info->state.sa_index);
+
+	hwe->ipv4.l2.meter &= ~AIROHA_FOE_TUNNEL_MTU;
+	hwe->ipv4.l2.meter |=
+		FIELD_PREP(AIROHA_FOE_TUNNEL_MTU,
+			   min_t(u32, info->tunnel_mtu,
+				 FIELD_MAX(AIROHA_FOE_TUNNEL_MTU)));
+	hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_TUNNEL_DECAP;
+
+	return 0;
+}
+
+static int
+airoha_ppe_foe_entry_set_soe_out(struct airoha_foe_entry *hwe,
+				 const struct airoha_ppe_soe_info *info)
+{
+	int err;
+
+	err = airoha_ppe_foe_entry_set_soe_fields(hwe, info);
+	if (err)
+		return err;
+
+	hwe->ipv4.l2.common.etype = AIROHA_PPE_SOE_MAGIC_IPSEC;
+	hwe->ipv4.data &= ~AIROHA_FOE_CHANNEL;
+	hwe->ipv4.data |=
+		FIELD_PREP(AIROHA_FOE_CHANNEL, AIROHA_PPE_SOE_CHANNEL);
+	hwe->ipv4.ib2 &= ~AIROHA_FOE_IB2_PORT_AG;
+	hwe->ipv4.ib2 |=
+		FIELD_PREP(AIROHA_FOE_IB2_PORT_AG, AIROHA_PPE_SOE_PORT_AG);
+
+	return 0;
+}
+
+static struct xfrm_state *
+airoha_ppe_soe_tuple_xfrm(const struct flow_offload_tuple *tuple, u8 *dir)
+{
+	struct dst_entry *child;
+	struct xfrm_state *x;
+
+	if (!tuple)
+		return NULL;
+	if (tuple->xfrm_input &&
+	    tuple->xmit_type == FLOW_OFFLOAD_XMIT_XFRM)
+		return ERR_PTR(-EOPNOTSUPP);
+
+	if (tuple->xfrm_input) {
+		*dir = XFRM_DEV_OFFLOAD_IN;
+		return tuple->xfrm_input;
+	}
+	if (tuple->xmit_type != FLOW_OFFLOAD_XMIT_XFRM)
+		return NULL;
+
+	child = xfrm_dst_child(tuple->dst_cache);
+	x = dst_xfrm(tuple->dst_cache);
+	if (!child || dst_xfrm(child) || !x)
+		return ERR_PTR(-EOPNOTSUPP);
+
+	*dir = XFRM_DEV_OFFLOAD_OUT;
+	return x;
+}
+
+static int
+airoha_ppe_soe_flow_add(struct airoha_eth *eth,
+			const struct flow_offload_tuple *tuple,
+			struct airoha_flow_table_entry *e,
+			struct airoha_ppe_soe_info *info,
+			const struct flow_action_entry *xfrm_act)
+{
+	struct xfrm_state *x;
+	u8 dir = 0;
+	int err;
+
+	x = airoha_ppe_soe_tuple_xfrm(tuple, &dir);
+	if (IS_ERR(x))
+		return PTR_ERR(x);
+	if (!x)
+		return xfrm_act ? -EOPNOTSUPP : 0;
+	if (!xfrm_act || xfrm_act->id != FLOW_ACTION_XFRM ||
+	    xfrm_act->xfrm.state != x || xfrm_act->xfrm.dir != dir ||
+	    xfrm_act->xfrm.policy_genid != tuple->xfrm_policy_genid)
+		return -EOPNOTSUPP;
+	if (dir == XFRM_DEV_OFFLOAD_IN &&
+	    (!xfrm_act->xfrm.flow_id_valid ||
+	     xfrm_act->xfrm.flow_id != tuple->xfrm_input_flow_id))
+		return -EOPNOTSUPP;
+	if (!tuple->xfrm_policy_genid ||
+	    tuple->xfrm_policy_genid != xfrm_policy_generation(xs_net(x)))
+		return -ENOENT;
+	if (dir == XFRM_DEV_OFFLOAD_OUT &&
+	    (!tuple->dst_cache ||
+	     !dst_check(tuple->dst_cache, tuple->dst_cookie)))
+		return -ENOENT;
+	if (tuple->l3proto != NFPROTO_IPV4 || x->props.family != AF_INET)
+		return -EOPNOTSUPP;
+
+	err = airoha_soe_ppe_flow_add(eth->soe, x, dir,
+				      &e->soe_flow, &info->state);
+	if (err)
+		return err;
+
+	info->input = dir == XFRM_DEV_OFFLOAD_IN;
+	info->tunnel_mtu = tuple->mtu ? tuple->mtu :
+					      AIROHA_PPE_SOE_DEFAULT_TUNNEL_MTU;
+
+	return 1;
+}
+
 static u32 airoha_ppe_foe_get_entry_hash(struct airoha_ppe *ppe,
 					 struct airoha_foe_entry *hwe)
 {
@@ -658,6 +898,9 @@ static void airoha_ppe_foe_flow_stats_update(struct airoha_ppe *ppe,
 		meter = &hwe->ipv4.l2.meter;
 	}
 
+	if (*data & AIROHA_FOE_TUNNEL)
+		return;
+
 	pse_port = FIELD_GET(AIROHA_FOE_IB2_PSE_PORT, *ib2);
 	if (pse_port == FE_PSE_PORT_CDM4)
 		return;
@@ -740,6 +983,52 @@ static bool airoha_ppe_foe_compare_entry(struct airoha_flow_table_entry *e,
 	return !memcmp(&e->data.d, &hwe->d, len - sizeof(hwe->ib1));
 }
 
+static struct airoha_foe_entry *
+airoha_ppe_foe_find_learned_entry(struct airoha_ppe *ppe,
+				  struct airoha_flow_table_entry *e, u32 *hash)
+{
+	const u32 set_mask = (PPE_SRAM_NUM_ENTRIES / 4) - 1;
+	const int set_shift = __ffs(PPE_SRAM_NUM_ENTRIES / 4);
+	const struct airoha_foe_ipv4_tuple *tuple = &e->data.ipv4.orig_tuple;
+	struct airoha_foe_entry *hwe;
+	u32 base, value;
+	int i, way;
+
+	lockdep_assert_held(&ppe_lock);
+
+	/* PPE SRAM hash 0 uses mode 0 and four ways. Match a learned entry
+	 * instead of writing the legacy software hash, which does not identify
+	 * a hardware SRAM slot on EN7581.
+	 */
+	value = PPE_HASH_SEED;
+	value = (value >> 24) | (value << 8);
+	value ^= tuple->ports ^ tuple->dest_ip ^ tuple->src_ip;
+	base = (value & set_mask) ^ ((value >> set_shift) & set_mask) ^
+	       (value >> (2 * set_shift));
+	base = (base & set_mask) * 4;
+
+	for (i = 0; i < ppe->eth->soc->num_ppe; i++) {
+		for (way = 0; way < 4; way++) {
+			u32 candidate = i * PPE_SRAM_NUM_ENTRIES + base + way;
+			u32 state;
+
+			hwe = airoha_ppe_foe_get_entry_locked(ppe, candidate);
+			if (!hwe)
+				continue;
+
+			state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+			if (state != AIROHA_FOE_STATE_UNBIND ||
+			    !airoha_ppe_foe_compare_entry(e, hwe))
+				continue;
+
+			*hash = candidate;
+			return hwe;
+		}
+	}
+
+	return NULL;
+}
+
 static int airoha_ppe_foe_commit_sram_entry(struct airoha_ppe *ppe, u32 hash)
 {
 	struct airoha_foe_entry *hwe = ppe->foe + hash * sizeof(*hwe);
@@ -761,6 +1050,22 @@ static int airoha_ppe_foe_commit_sram_entry(struct airoha_ppe *ppe, u32 hash)
 					REG_PPE_RAM_CTRL(ppe2));
 }
 
+static int
+airoha_ppe_foe_invalidate_entry(struct airoha_ppe *ppe,
+				struct airoha_foe_entry *hwe, u32 hash)
+{
+	u32 sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+
+	hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+	hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
+				  AIROHA_FOE_STATE_INVALID);
+	/* Publish the invalid state before asking PPE to copy it into SRAM. */
+	wmb();
+
+	return hash < sram_num_entries ?
+		airoha_ppe_foe_commit_sram_entry(ppe, hash) : 0;
+}
+
 static int airoha_ppe_foe_commit_entry(struct airoha_ppe *ppe,
 				       struct airoha_foe_entry *e,
 				       u32 hash, bool rx_wlan)
@@ -798,12 +1103,161 @@ static int airoha_ppe_foe_commit_entry(struct airoha_ppe *ppe,
 	return err;
 }
 
-static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
-				       struct airoha_flow_table_entry *e)
+static void airoha_ppe_soe_bind_cancel_locked(struct airoha_ppe *ppe,
+					      struct airoha_flow_table_entry *e)
+{
+	lockdep_assert_held(&ppe_lock);
+
+	if (list_empty(&e->soe_bind_node))
+		return;
+
+	list_del_init(&e->soe_bind_node);
+	airoha_soe_ppe_flow_bind_abort(&e->soe_flow);
+}
+
+static bool
+airoha_ppe_soe_bind_hold_locked(struct airoha_ppe *ppe,
+				struct airoha_foe_entry *hwe, u32 hash)
+{
+	struct airoha_flow_table_entry *e;
+
+	lockdep_assert_held(&ppe_lock);
+
+	list_for_each_entry(e, &ppe->soe_bind_pending, soe_bind_node) {
+		if (e->soe_bind_hash == hash &&
+		    airoha_ppe_foe_compare_entry(e, hwe))
+			goto found;
+	}
+
+	return false;
+
+found:
+	if (airoha_ppe_foe_invalidate_entry(ppe, hwe, hash)) {
+		airoha_ppe_soe_bind_cancel_locked(ppe, e);
+		if (airoha_ppe_soe_quiesce_locked(ppe))
+			dev_err_ratelimited(ppe->eth->dev,
+					    "failed to hold SOE flow unbound; keeping IPsec PPE path disabled\n");
+	}
+
+	return true;
+}
+
+void airoha_ppe_soe_bind_cancel(struct airoha_eth *eth,
+				struct airoha_soe_ppe_flow *flow)
+{
+	struct airoha_flow_table_entry *e;
+	struct airoha_ppe *ppe;
+
+	if (!eth || !eth->ppe || !flow)
+		return;
+
+	e = container_of(flow, struct airoha_flow_table_entry, soe_flow);
+	ppe = eth->ppe;
+	spin_lock_bh(&ppe_lock);
+	airoha_ppe_soe_bind_cancel_locked(ppe, e);
+	spin_unlock_bh(&ppe_lock);
+}
+
+static void
+airoha_ppe_foe_add_soe_input_owner(struct airoha_ppe *ppe,
+				   struct airoha_flow_table_entry *e)
+{
+	struct airoha_flow_table_entry *owner;
+	u32 index;
+
+	lockdep_assert_held(&ppe_lock);
+
+	if (!e->soe_flow.input || e->hash == 0xffff)
+		return;
+
+	index = airoha_ppe_foe_get_entry_hash(ppe, &e->data);
+	hlist_for_each_entry(owner, &ppe->foe_flow[index], list) {
+		if (owner->type == FLOW_TYPE_SOE_INPUT_OWNER &&
+		    owner->hash == e->hash &&
+		    owner->soe_flow.sa == e->soe_flow.sa &&
+		    airoha_ppe_foe_compare_entry(owner, &e->data))
+			return;
+	}
+
+	owner = kzalloc_obj(*owner, GFP_ATOMIC);
+	if (!owner)
+		return;
+
+	INIT_LIST_HEAD(&owner->soe_flow.sa_node);
+	INIT_LIST_HEAD(&owner->soe_flow.soe_node);
+	INIT_LIST_HEAD(&owner->soe_bind_node);
+	owner->type = FLOW_TYPE_SOE_INPUT_OWNER;
+	owner->hash = e->hash;
+	memcpy(&owner->data, &e->data, sizeof(owner->data));
+	if (!airoha_soe_ppe_flow_bind_clone(&owner->soe_flow,
+					    &e->soe_flow)) {
+		kfree(owner);
+		return;
+	}
+
+	hlist_add_head(&owner->list, &ppe->foe_flow[index]);
+}
+
+void airoha_ppe_soe_bind_ready(struct airoha_eth *eth)
 {
+	struct airoha_flow_table_entry *e, *tmp;
 	struct airoha_foe_entry *hwe;
+	struct airoha_ppe *ppe;
+
+	if (!eth || !eth->ppe)
+		return;
+
+	ppe = eth->ppe;
+	spin_lock_bh(&ppe_lock);
+	list_for_each_entry_safe(e, tmp, &ppe->soe_bind_pending,
+				 soe_bind_node) {
+		u32 hash = e->soe_bind_hash;
+		u32 learned_hash;
+		int err;
+
+		if (!airoha_soe_ppe_flow_bind_ready(&e->soe_flow))
+			continue;
+		list_del_init(&e->soe_bind_node);
+
+		hwe = airoha_ppe_foe_find_learned_entry(ppe, e, &learned_hash);
+		if (hwe) {
+			hash = learned_hash;
+			e->soe_bind_hash = hash;
+		} else {
+			hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+		}
+		if (!hwe || !airoha_ppe_foe_compare_entry(e, hwe)) {
+			airoha_soe_ppe_flow_bind_abort(&e->soe_flow);
+			continue;
+		}
+
+		err = airoha_ppe_foe_commit_entry(ppe, &e->data, hash,
+						  e->soe_bind_rx_wlan);
+		if (!err && airoha_soe_ppe_flow_bind_finish(&e->soe_flow)) {
+			e->hash = hash;
+			airoha_ppe_foe_add_soe_input_owner(ppe, e);
+			continue;
+		}
+		airoha_soe_ppe_flow_bind_abort(&e->soe_flow);
+		if (airoha_ppe_soe_quiesce_locked(ppe))
+			dev_err_ratelimited(eth->dev,
+					    "failed to commit drained SOE flow; keeping IPsec PPE path disabled\n");
+	}
+	spin_unlock_bh(&ppe_lock);
+}
+
+static int airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
+				      struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_entry data = e->data;
+	struct airoha_foe_entry *hwe = NULL;
+	struct airoha_foe_entry hwe_data;
+	bool linked = !hlist_unhashed(&e->list);
+	u32 index = 0;
+	int err = 0;
 
 	lockdep_assert_held(&ppe_lock);
+	airoha_ppe_soe_bind_cancel_locked(ppe, e);
 
 	/* If the flow was never committed to hardware (e->hash == 0xffff),
 	 * compute the hash slot from e->data and invalidate any stale BIND
@@ -820,56 +1274,99 @@ static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
