+int airoha_ppe_soe_flush_sa(struct airoha_eth *eth,
+			    struct airoha_soe_sa *sa)
+{
+	LIST_HEAD(failed);
+	struct airoha_soe_ppe_flow *flow;
+	int err = 0;
+
+	if (!eth || !eth->ppe || !sa)
+		return -EINVAL;
+
+	mutex_lock(&flow_offload_mutex);
+	while ((flow = airoha_soe_ppe_flow_pop_sa(sa))) {
+		struct airoha_flow_table_entry *e;
+		int ret;
+
+		e = container_of(flow, struct airoha_flow_table_entry, soe_flow);
+		ret = airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+		if (ret) {
+			list_add_tail(&flow->sa_node, &failed);
+			if (!err)
+				err = ret;
+		} else {
+			airoha_ppe_soe_flow_release(flow);
+		}
+	}
+	while (!list_empty(&failed)) {
+		flow = list_first_entry(&failed,
+					struct airoha_soe_ppe_flow, sa_node);
+		list_del_init(&flow->sa_node);
+		airoha_soe_ppe_flow_restore(flow);
+	}
+	mutex_unlock(&flow_offload_mutex);
+
+	return err;
+}
